# Copy to .env.local and enter values from Supabase > Connect / Project Settings > API Keys.
# Leave BOTH empty to keep the existing local browser mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# Never put a secret/service_role key or database password in NEXT_PUBLIC_* variables.
